# FlowForge environment variable reference
# Copy to .env for local use:  cp .env.example .env
# The app does NOT auto-load .env — export before running:
#   set -a && source .env && set +a && dotnet run --project src/FlowForge.Api
#
# Config precedence: appsettings.json → appsettings.{Environment}.json → user secrets (Development) → env vars
# Env vars use double underscores: Jwt__Secret → Jwt:Secret

# =============================================================================
# Local development (SQLite — defaults match appsettings.json)
# =============================================================================

ASPNETCORE_ENVIRONMENT=Development

# SQLite is the default provider for all non-Production environments
Database__Provider=Sqlite
ConnectionStrings__DefaultConnection=Data Source=flowforge.db

# JWT signing key (≥ 32 chars). Dev default lives in appsettings.json.
# Prefer user secrets locally instead of committing overrides:
#   cd src/FlowForge.Api && dotnet user-secrets init
#   dotnet user-secrets set "Jwt:Secret" "your-local-secret-at-least-32-characters"
Jwt__Secret=FlowForge-Dev-Secret-Key-At-Least-32-Chars!

Jwt__Issuer=FlowForge
Jwt__Audience=FlowForge
Jwt__ExpiryMinutes=60

RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60

# =============================================================================
# Production (SQL Server + secrets via environment — do NOT commit real values)
# =============================================================================
# Uncomment and fill when deploying. Never put Jwt__Secret in appsettings.Production.json.
#
# ASPNETCORE_ENVIRONMENT=Production
# Database__Provider=SqlServer
# ConnectionStrings__DefaultConnection=Server=sql.example.com;Database=FlowForge;User Id=flowforge_app;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False;
# Jwt__Secret=REPLACE_WITH_SECRET_FROM_STORE_MIN_32_CHARS
# Cors__AllowedOrigins__0=https://app.example.com
# AllowedHosts=flowforge.example.com;api.flowforge.example.com
