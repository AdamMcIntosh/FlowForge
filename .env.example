# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://flowforge:flowforge@localhost:5432/flowforge?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT (RS256) — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Store PEM contents as single-line values with \n for newlines.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# Rate limiting (fixed window, per-IP and per-user on /auth/* routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
